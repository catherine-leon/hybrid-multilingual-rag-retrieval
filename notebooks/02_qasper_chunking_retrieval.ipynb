      "source": [
        "def make_search_fns(name):\n",
        "    idx = indexes[name]\n",
        "    return {\n",
        "        \"BM25\":   lambda r, k: idx[r[\"paper_id\"]].bm25_search(r[\"question\"], k),\n",
        "        \"Dense\":  lambda r, k: idx[r[\"paper_id\"]].dense_search(r[\"question\"], dense_model, k),\n",
        "        \"Hybrid\": lambda r, k: idx[r[\"paper_id\"]].hybrid_search(r[\"question\"], dense_model, k),\n",
        "        \"Hybrid+CE\": lambda r, k: idx[r[\"paper_id\"]].reranked_search(r[\"question\"], dense_model, reranker, k),\n",
        "    }\n",
        "\n",
        "results, all_rankings = [], {}\n",
        "for name in chunks:\n",
        "    for method, fn in make_search_fns(name).items():\n",
        "        m, rankings = evaluate_qasper(fn, eval_qs, gold[name], chunk_info[name])\n",
        "        results.append({\"chunking\": name, \"method\": method, **m})\n",
        "        all_rankings[(name, method)] = rankings\n",
        "        print(name, method, \"done\")\n",
        "\n",
        "df = pd.DataFrame(results).round(3)\n",
        "df.to_csv(ROOT / \"results\" / \"qasper_retrieval_metrics.csv\", index=False)\n",
        "df"
      ]
    },
