        "## 8. Error analysis\n",
        "\n",
        "Questions where one setup finds gold evidence in the top 5 and another does not.\n",
        "Uses the rankings saved in section 7, so no models or GPU are needed (run sections 1–4 first).\n",
        "For each pattern: number of questions and up to 3 examples (question, gold paragraph, top-1 chunk of each setup)."
      ],
      "metadata": {
        "id": "-_VYa9d0P964"
      },
      "id": "-_VYa9d0P964"
    },
    {
      "cell_type": "code",
      "source": [
        "import json\n",
        "from collections import defaultdict\n",
        "\n",
        "# rankings saved by section 7 (no models needed: run sections 1-4 first)\n",
        "R = defaultdict(dict)\n",
        "with open(ROOT / \"results\" / \"qasper_rankings.jsonl\", encoding=\"utf-8\") as f:\n",
        "    for line in f:\n",
        "        x = json.loads(line)\n",
        "        R[(x[\"chunking\"], x[\"method\"])][x[\"question_id\"]] = x[\"ranked\"]\n",
        "\n",
        "gold_sets = {name: {r[\"question_id\"]: set(gold_chunk_ids(chunks[name][r[\"paper_id\"]], r[\"gold_paragraphs\"]))\n",
        "                    for r in eval_qs} for name in chunks}\n",
        "info = {name: {c[\"chunk_id\"]: c for cs in chunks[name].values() for c in cs} for name in chunks}\n",
        "qs = {r[\"question_id\"]: r for r in eval_qs}\n",
        "\n",
        "def gold_rank(name, method, qid, k=5):\n",
        "    for i, c in enumerate(R[(name, method)][qid][:k], 1):\n",
        "        if c in gold_sets[name][qid]:\n",
        "            return i\n",
        "    return None\n",
        "\n",
        "def find(fail, success, k=5):\n",
        "    \"\"\"fail / success = (chunking, method)\"\"\"\n",
        "    return [q for q in qs if gold_rank(*fail, q, k) is None and gold_rank(*success, q, k) is not None]\n",
        "\n",
        "def show(qid, setups):\n",
        "    r = qs[qid]\n",
        "    print(\"QUESTION:\", r[\"question\"], f\"  [{qid}]\")\n",
        "    name0 = setups[0][0]\n",
        "    g = sorted(gold_sets[name0][qid])[0]\n",
        "    print(\"GOLD:\", info[name0][g][\"text\"][:300], \"...\")\n",
        "    for name, m in setups:\n",
        "        top1 = info[name][R[(name, m)][qid][0]][\"text\"][:150]\n",
        "        print(f\"  {name} / {m}: gold at rank {gold_rank(name, m, qid)} | top-1: {top1}...\")\n",
        "    print()\n",
        "\n",
        "P, PS = \"paragraph\", \"paragraph+section\"\n",
        "cases = {\n",
        "    \"BM25 fails, Dense succeeds\": ((P, \"BM25\"), (P, \"Dense\")),\n",
        "    \"Dense succeeds, Hybrid fails (RRF hurts)\": ((P, \"Hybrid\"), (P, \"Dense\")),\n",
        "    \"Hybrid fails, Hybrid+CE succeeds\": ((P, \"Hybrid\"), (P, \"Hybrid+CE\")),\n",
        "    \"Section name helps BM25\": ((P, \"BM25\"), (PS, \"BM25\")),\n",
        "}\n",
        "for title, (fail, success) in cases.items():\n",
        "    ids = find(fail, success)\n",
        "    print(f\"===== {title}: {len(ids)} questions =====\\n\")\n",
        "    for qid in ids[:3]:\n",
        "        show(qid, [fail, success])"
      ],
