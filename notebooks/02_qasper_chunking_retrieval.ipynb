      "source": [
        "chunks = {}   # strategy -> {paper_id: [chunks]}\n",
        "for name, chunker in CHUNKERS.items():\n",
        "    chunks[name] = {pid: chunker(pid, paragraphs_by_paper[pid]) for pid in eval_papers}\n",
        "\n",
        "rows = []\n",
        "for name, by_paper in chunks.items():\n",
        "    all_c = [c for cs in by_paper.values() for c in cs]\n",
        "    lens = [len(c[\"text\"].split()) for c in all_c]\n",
        "    rows.append({\"chunking\": name, \"chunks/paper\": len(all_c) / len(by_paper),\n",
        "                 \"mean words\": sum(lens) / len(lens), \"max words\": max(lens)})\n",
        "pd.DataFrame(rows)"
      ]
